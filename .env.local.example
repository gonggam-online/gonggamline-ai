# Supabase — 기존 값을 유지하세요.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Coupang Open API — 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
COUPANG_ACCESS_KEY=YOUR_COUPANG_ACCESS_KEY
COUPANG_SECRET_KEY=YOUR_COUPANG_SECRET_KEY
COUPANG_VENDOR_ID=A00000000

# Optional provider integrations. The UI shows "No data available" when omitted.
DOMEGGOOK_API_KEY=YOUR_DOMEGGOOK_API_KEY
COUPANG_MARKET_DATA_ENDPOINT=https://your-provider.example/api/market-data
COUPANG_MARKET_DATA_API_KEY=YOUR_MARKET_DATA_API_KEY

# NAVER API HUB — server-only. Existing NAVER_CLIENT_* names are accepted as
# migration fallbacks, but new deployments should use these canonical names.
NAVER_API_HUB_CLIENT_ID=YOUR_NAVER_API_HUB_CLIENT_ID
NAVER_API_HUB_CLIENT_SECRET=YOUR_NAVER_API_HUB_CLIENT_SECRET
# Optional: Naver Shopping cat_id. When omitted, Search Trend still runs and
# Shopping Insight is skipped rather than guessing a category.
NAVER_API_HUB_SHOPPING_CATEGORY_ID=
